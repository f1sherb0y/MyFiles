new file mode 100644
index 0000000..988a1ac
--- /dev/null
+++ b/ui/prewarm.go
@@ -0,0 +1,8 @@
+package ui
+
+// Prewarm starts what the first window of native UI would otherwise wait
+// for in its first frame, on another thread, and returns at once: on
+// Windows the Direct3D device, whose driver takes a while to load. An app
+// that knows it will show native UI calls it as it starts, before
+// mygo.App.Run; calling it is never needed, and does nothing elsewhere.
+func Prewarm() { prewarm() }
