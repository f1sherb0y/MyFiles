diff --git a/ui/tester_drag.go b/ui/tester_drag.go
new file mode 100644
index 0000000..0d3c4d3
--- /dev/null
+++ b/ui/tester_drag.go
@@ -0,0 +1,57 @@
+package ui
+
+import (
+	"github.com/egoist/mygo/internal/platform"
+	"github.com/egoist/mygo/transfer"
+)
+
+// DragData returns the data of the native drag the view started, as a
+// press on an element with DragData that moved, and whether one is under
+// way; the operations are those its source allows.
+func (t *Tester) DragData() (data transfer.Data, operations transfer.Operation, dragging bool) {
+	if len(t.h.dragData.Formats()) == 0 {
+		return transfer.Data{}, transfer.None, false
+	}
+	ops := t.h.dragOptions.Operations
+	if ops == transfer.None {
+		ops = transfer.Copy
+	}
+	return t.h.dragData, ops, true
+}
+
+// DragDataOver moves a native drag of data over (x, y), as one coming
+// from another window or application, and returns the operation the
+// element there would take it with, None when none takes it. suggested is
+// what the modifier keys held ask for, None for none.
+func (t *Tester) DragDataOver(x, y float32, data transfer.Data, operations, suggested transfer.Operation) transfer.Operation {
+	d := &platform.DataDragEvent{Offer: transfer.Offer{Formats: data.Formats(), Operations: operations, Suggested: suggested}}
+	t.rt.event(platform.SurfaceEvent{Kind: platform.DataDragOver, X: float64(x), Y: float64(y), Drag: d})
+	t.settle()
+	return d.Operation
+}
+
+// DropData drops data at (x, y), as a native drag let go there, and
+// returns the operation the element under it took the data with, None
+// when none did. It ends the drag the view started, if any, with that
+// operation, as the system tells a source what became of its drag.
+func (t *Tester) DropData(x, y float32, data transfer.Data, operations, suggested transfer.Operation) transfer.Operation {
+	d := &platform.DataDragEvent{Offer: transfer.Offer{Formats: data.Formats(), Operations: operations, Suggested: suggested}}
+	t.rt.event(platform.SurfaceEvent{Kind: platform.DataDragOver, X: float64(x), Y: float64(y), Drag: d})
+	d.Data = data
+	taken := t.rt.event(platform.SurfaceEvent{Kind: platform.DataDrop, X: float64(x), Y: float64(y), Drag: d})
+	op := d.Operation
+	if !taken {
+		op = transfer.None
+	}
+	if len(t.h.dragData.Formats()) > 0 {
+		t.h.finishDataDrag(transfer.Result{Operation: op, Canceled: op == transfer.None})
+	}
+	t.settle()
+	return op
+}
+
+// WheelWith is Wheel with modifier keys held, as Ctrl and the wheel, which
+// zooms where an element's HandleInput takes it.
+func (t *Tester) WheelWith(mods Modifiers, x, y, dx, dy float32) {
+	t.send(platform.SurfaceEvent{Kind: platform.PointerScroll, X: float64(x), Y: float64(y), DX: float64(dx), DY: float64(dy), Mods: platform.Modifiers(mods)})
+}
