+// TestGridViewNewStateKeepsColumns checks that a grid given a new state,
+// as an app does to show other items in it, takes the columns its element
+// had from the first frame: not the window's, to change in the next.
+func TestGridViewNewStateKeepsColumns(t *testing.T) {
+	s := &GridState{}
+	var first []int
+	tt := coreNewTester(func(c *context) {
+		coreRow(c).Grow(1).Children(func() {
+			coreBox(c).Width(216).Shrink(0)
+			coreGridView(c, s, 100, 100, 80, func(i int) {
+				coreTextf(c, "Item %d", i)
+			}).Grow(1)
+		})
+		first = append(first, s.cols)
+	}, 664, 300)
+	tt.Frame()
+	// 448 wide beside the box: (448 + 8) / 108, 4 columns.
+	if s.cols != 4 {
+		t.Fatalf("%d columns", s.cols)
+	}
+	s, first = &GridState{}, nil
+	tt.Frame()
+	tt.Frame()
+	for i, cols := range first {
+		if cols != 4 {
+			t.Errorf("frame %d of the new state built %d columns", i, cols)
+		}
+	}
+}
